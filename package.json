{
  "name": "tsai_roulette",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "npm run build && vite preview",
    "pages:dev": "npm run build && wrangler pages dev dist/client",
    "pages:deploy": "npm run build && wrangler pages deploy dist/client",
    "spotify:auth": "node scripts/spotify-auth.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.2",
    "@cloudflare/workers-types": "latest",
    "@types/node": "^24.3.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "wrangler": "^4.24.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260828.1": true
  }
}
